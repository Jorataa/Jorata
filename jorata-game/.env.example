# Default workspace: no secrets or Supabase settings required.
# Future account integration only; leave disabled for the guest/sample experience.
VITE_ENABLE_ACCOUNTS=false

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: leave unset until a Gemini key is supplied. Never prefix with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
