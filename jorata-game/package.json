{
  "name": "jorata-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3107",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 0.0.0.0 --port 3107",
    "test": "tsx --test src/play/*.test.ts src/surgery/*.test.ts src/boxing/*.test.ts",
    "test:browser": "tsx tests/product.browser.ts && tsx tests/play.browser.ts && tsx tests/notes.browser.ts",
    "test:surgery": "tsx tests/surgery.browser.ts && tsx tests/surgery.media.browser.ts",
    "test:rooftop": "node scripts/rooftop-assets.mjs && node --import tsx src/rooftop/model.test.ts",
    "test:rooftop:browser": "node --import tsx tests/rooftop.browser.ts",
    "test:boxing": "tsx tests/boxing.browser.ts",
    "test:drive": "node --import tsx tests/drive.browser.ts",
    "test:drive:live": "node --import tsx tests/drive.browser.ts --live"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
