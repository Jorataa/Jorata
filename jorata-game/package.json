{
  "name": "jorata-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "VITE_ENABLE_LEGACY_WORLD=true npm run build && tsx tests/browser.ts",
    "test:social": "node --env-file=.env.local --import tsx tests/social.integration.ts",
    "test:social:browser": "node --env-file=.env.local --import tsx tests/social.browser.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "supabase": "2.121.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
