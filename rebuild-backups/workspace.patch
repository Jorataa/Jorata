-
-      setIsLoading(true);
-      const controller = new AbortController();
-      activeController = controller;
-      try {
-        const response = await fetch("/api/ai/mindmap", {
-          method: "POST",
-          headers: { "Content-Type": "application/json" },
-          body: JSON.stringify({ prompt: topic }),
-          signal: controller.signal,
