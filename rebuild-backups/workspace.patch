-          const { lastResetAt } = get();
-          if (!lastResetAt) return false;
-
-          const lastDate = new Date(lastResetAt).toDateString();
-          const today = new Date().toDateString();
-
-          if (lastDate !== today) {
-            return true;
-          }
-          return false;
-        },
