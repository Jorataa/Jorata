-      if (parentEdges.some((e) => e.source === parent.id)) continue; // already there
-
-      if (op.type === "move") {
-        const removed = new Set(parentEdges.map((e) => e.id));
-        nextEdges = nextEdges.filter((e) => !removed.has(e.id));
-      }
