-/** The Evergreen ink palette offered by the draw toolbar. */
-export const DRAWING_COLORS = [
-  "#1F2921", // ink
-  "#24523B", // deep green
-  "#1E9B68", // emerald
-  "#C99A2E", // ochre
-  "#A65A3A", // clay
-  "#4A6FA5", // slate blue
-] as const;
-
-export const DRAWING_SIZES = [2.5, 4.5, 8] as const;
