-/** Stable per-note tilt: same note, same lean, every load. */
-function tiltFor(id: string): number {
-  let hash = 0;
-  for (let i = 0; i < id.length; i++) hash = (hash * 31 + id.charCodeAt(i)) | 0;
-  return (Math.abs(hash) % 2 === 0 ? 1 : -1) * (1.2 + (Math.abs(hash) % 5) / 10);
-}
