-
-  const ideaNodeCount = useMemo(
-    () => nodes.filter((n) => (n.type ?? "editable") === "editable").length,
-    [nodes]
-  );
-  const tooSmall = ideaNodeCount < MIN_NODES_FOR_FIX;
-
-  // Accepted-by-default: the user came here for suggestions; unchecking is the
