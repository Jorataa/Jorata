-.wisdom-ray        { animation: wisdom-ray-sway var(--ray-dur, 11s) ease-in-out infinite; animation-delay: var(--ray-delay, 0s); transform-origin: top center; will-change: transform, opacity; }
-.wisdom-orb        { animation: wisdom-orb var(--orb-dur, 18s) ease-in-out infinite; animation-delay: var(--orb-delay, 0s); will-change: transform, opacity; }
