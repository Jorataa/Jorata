-  const runVerb = (verb: "Summarize" | "Simplify" | "Expand") => {
-    const excerpt = selection.length > 1200 ? `${selection.slice(0, 1199)}…` : selection;
-    openAssistant(`${verb} this passage from my note "${title || "Untitled"}":\n\n${excerpt}`);
-    setSelection("");
-  };
